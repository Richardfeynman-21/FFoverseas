{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo -p 3000",
    "build": "next build",
    "postbuild": "node -e \"const fs = require('fs'); const path = './.next/routes-manifest.json'; if (fs.existsSync(path)) { const m = JSON.parse(fs.readFileSync(path, 'utf8')); m.staticRoutes = m.staticRoutes || []; m.dynamicRoutes = m.dynamicRoutes || []; m.dataRoutes = m.dataRoutes || []; fs.writeFileSync(path, JSON.stringify(m), 'utf8'); }\"",
    "start": "next start -p 3000",
    "clean": "rm -rf .next dist",
    "lint": "next lint"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.2.10",
    "nodemailer": "^8.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
